# Copiar a .env y completar con los valores reales.
# El archivo .env está en .gitignore: las credenciales NUNCA se commitean.

# --- Base de datos: MariaDB (lineamiento de la cátedra) ---
# Formato: mysql+pymysql://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL="mysql+pymysql://root:TU_PASSWORD@localhost:3306/erp_grupo21_flask"

# Clave con la que Flask firma la cookie de sesión. En producción tiene que ser
# larga y aleatoria: quien la conozca puede fabricar sesiones de cualquier usuario.
SECRET_KEY="poner-una-clave-larga-y-aleatoria"

# --- Sesión ---
# Minutos de inactividad antes de que la sesión caduque.
MINUTOS_SESION="30"
# Poner en "true" cuando el sistema se sirva por HTTPS: la cookie deja de
# viajar por conexiones sin cifrar.
COOKIE_SEGURA="false"
