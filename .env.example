# Copiar a .env y completar con los valores reales.
# El archivo .env está en .gitignore: las credenciales NUNCA se commitean.

# --- Base de datos (Supabase → Project Settings → Database → Connection string) ---
# Pooler, para la app en runtime (puerto 6543)
DATABASE_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa, para migraciones de Prisma (puerto 5432)
DIRECT_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- IA (sugerencia de reposición) ---
AI_API_KEY=""
